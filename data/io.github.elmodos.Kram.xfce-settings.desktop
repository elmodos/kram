# Kram in the Xfce Settings Manager (System section). Xfce only: elsewhere Settings would move Kram out
# of System menus. No MimeType: the main io.github.elmodos.Kram.desktop opens .rpm files.
# The label (also in the applications menu's Settings) is the main file's GenericName; the translations
# repeat the main file's (tests/test_packaging.py keeps them in sync).
[Desktop Entry]
Type=Application
Name=Package Manager
Name[uk]=Менеджер пакунків
Name[de]=Paketverwaltung
Name[fr]=Gestionnaire de paquets
Name[es]=Gestor de paquetes
Name[it]=Gestore dei pacchetti
