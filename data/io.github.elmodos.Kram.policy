<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Kram</vendor>
  <vendor_url>https://github.com/elmodos/kram</vendor_url>
  <icon_name>io.github.elmodos.Kram</icon_name>

  <!-- One action for the whole helper: it runs for the session, so the password is asked once. -->
  <action id="io.github.elmodos.Kram.helper">
    <description>Manage software packages and repositories</description>
    <description xml:lang="uk">Керування пакунками та репозиторіями</description>
    <description xml:lang="de">Softwarepakete und Paketquellen verwalten</description>
    <description xml:lang="fr">Gérer les paquets logiciels et les dépôts</description>
    <description xml:lang="es">Gestionar paquetes de software y repositorios</description>
    <description xml:lang="it">Gestisci pacchetti software e repository</description>
    <description xml:lang="pt_BR">Gerenciar pacotes de software e repositórios</description>
    <description xml:lang="pl">Zarządzaj pakietami oprogramowania i repozytoriami</description>
    <description xml:lang="sv">Hantera programpaket och förråd</description>
    <description xml:lang="cs">Spravovat softwarové balíčky a repozitáře</description>
    <description xml:lang="zh_CN">管理软件包和软件源</description>
    <description xml:lang="ja">ソフトウェアパッケージとリポジトリを管理</description>
    <description xml:lang="ko">소프트웨어 패키지와 저장소 관리</description>
    <message>Authentication is required to install, remove or upgrade packages and to change repositories</message>
    <message xml:lang="uk">Для встановлення, вилучення чи оновлення пакунків і зміни репозиторіїв потрібна автентифікація</message>
    <message xml:lang="de">Zum Installieren, Entfernen oder Aktualisieren von Paketen und zum Ändern von Paketquellen ist eine Authentifizierung erforderlich</message>
    <message xml:lang="fr">Une authentification est requise pour installer, supprimer ou mettre à jour des paquets et pour modifier les dépôts</message>
    <message xml:lang="es">Se requiere autenticación para instalar, eliminar o actualizar paquetes y para cambiar repositorios</message>
    <message xml:lang="it">È richiesta l'autenticazione per installare, rimuovere o aggiornare pacchetti e per modificare i repository</message>
    <message xml:lang="pt_BR">É necessária autenticação para instalar, remover ou atualizar pacotes e para alterar repositórios</message>
    <message xml:lang="pl">Instalowanie, usuwanie lub aktualizowanie pakietów oraz zmiana repozytoriów wymaga uwierzytelnienia</message>
    <message xml:lang="sv">Autentisering krävs för att installera, ta bort eller uppgradera paket och för att ändra förråd</message>
    <message xml:lang="cs">K instalaci, odebrání nebo aktualizaci balíčků a ke změně repozitářů je vyžadováno ověření</message>
    <message xml:lang="zh_CN">安装、删除或升级软件包以及更改软件源需要认证</message>
    <message xml:lang="ja">パッケージのインストール、削除、アップグレード、およびリポジトリの変更には認証が必要です</message>
    <message xml:lang="ko">패키지를 설치, 제거 또는 업그레이드하거나 저장소를 변경하려면 인증이 필요합니다</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/kram-helper</annotate>
  </action>
</policyconfig>
