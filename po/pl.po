#: kram/app/actions.py:33
msgid "Mark Security Upgrades"
msgstr "Zaznacz aktualizacje bezpieczeństwa"

#: kram/app/actions.py:34
msgid "Mark the upgrades that fix a security issue, as dnf upgrade --security"
msgstr ""
"Zaznacz aktualizacje usuwające problem bezpieczeństwa, jak dnf upgrade --"
"security"

#: kram/app/actions.py:35
msgid "Mark Critical and Important Security Upgrades"
msgstr "Zaznacz krytyczne i ważne aktualizacje bezpieczeństwa"

#: kram/app/actions.py:36
msgid "Mark the upgrades that fix a security issue rated critical or important"
msgstr ""
"Zaznacz aktualizacje usuwające krytyczny lub ważny problem bezpieczeństwa"

