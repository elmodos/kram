msgid ""
"Mark the upgrades that fix a security issue or bugs, leaving out enhancements"
msgstr ""
"Zaznacz aktualizacje usuwające problemy bezpieczeństwa lub błędy, bez "
"ulepszeń"

#: kram/app/actions.py:57 kram/app/empty_list.py:52
msgid "Reload"
msgstr "Wczytaj ponownie"

#: kram/app/actions.py:58
msgid "Refresh repository metadata and reload the catalog (needs a password)"
msgstr ""
"Odśwież metadane repozytoriów i ponownie wczytaj katalog (wymaga hasła)"

