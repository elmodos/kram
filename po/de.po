#: kram/app/actions.py:33
msgid "Mark Security Upgrades"
msgstr "Sicherheitsaktualisierungen vormerken"

#: kram/app/actions.py:34
msgid "Mark the upgrades that fix a security issue, as dnf upgrade --security"
msgstr ""
"Die Aktualisierungen vormerken, die ein Sicherheitsproblem beheben, wie dnf "
"upgrade --security"

