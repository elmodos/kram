#: kram/app/actions.py:33
msgid "Mark All Security Upgrades"
msgstr "Označit všechny bezpečnostní aktualizace"

#: kram/app/actions.py:34
msgid "Mark the upgrades that fix a security issue, as dnf upgrade --security"
msgstr ""
"Označit aktualizace, které opravují bezpečnostní problém, jako dnf upgrade --"
"security"

#: kram/app/actions.py:35
msgid "Mark Critical and Important Security Upgrades"
msgstr "Označit kritické a důležité bezpečnostní aktualizace"

#: kram/app/actions.py:36
msgid "Mark the upgrades that fix a security issue rated critical or important"
msgstr ""
"Označit aktualizace, které opravují kritický nebo důležitý bezpečnostní "
"problém"

#: kram/app/actions.py:37
msgid "Mark Security and Bug Fix Upgrades"
msgstr "Označit bezpečnostní aktualizace a opravy chyb"

#: kram/app/actions.py:38
msgid ""
"Mark the upgrades that fix a security issue or bugs, leaving out enhancements"
msgstr ""
"Označit aktualizace, které opravují bezpečnostní problémy nebo chyby, bez "
"vylepšení"

