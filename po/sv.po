#, python-brace-format
msgid ""
"Installed before “{group}”: it was there with the system or for something "
"else, and removing the group takes it too."
msgstr ""
"Installerat före ”{group}”: det kom med systemet eller för något annat, och "
"att ta bort gruppen tar det också."

#: kram/app/apply_review.py:128
msgid ""
"All packages of the group are already installed: dnf only records the group "
"as installed."
msgid_plural ""
"All packages of the groups are already installed: dnf only records the "
"groups as installed."
msgstr[0] ""
"Alla paket i gruppen är redan installerade: dnf registrerar bara gruppen som "
"installerad."
msgstr[1] ""
"Alla paket i grupperna är redan installerade: dnf registrerar bara grupperna "
"som installerade."

#: kram/app/apply_review.py:132
msgid ""
"No package goes with the group (you installed them yourself, or something "
"else needs them): dnf only records the group as removed."
msgid_plural ""
"No package goes with the groups (you installed them yourself, or something "
"else needs them): dnf only records the groups as removed."
msgstr[0] ""
"Inget paket försvinner med gruppen (du installerade dem själv, eller något "
"annat behöver dem): dnf registrerar bara gruppen som borttagen."
msgstr[1] ""
"Inget paket försvinner med grupperna (du installerade dem själv, eller något "
"annat behöver dem): dnf registrerar bara grupperna som borttagna."

#: kram/app/apply_review.py:136
msgid "No package changes: dnf only updates its record of the groups."
msgstr "Inga paket ändras: dnf uppdaterar bara sin registrering av grupperna."

