#, python-brace-format
msgid ""
"Installed before “{group}”: it was there with the system or for something "
"else, and removing the group takes it too."
msgstr ""
"Installato prima di «{group}»: c'era con il sistema o per altro, e rimuovere "
"il gruppo porta via anche lui."

#: kram/app/apply_review.py:146
msgid ""
"All packages of the group are already installed: dnf only records the group "
"as installed."
msgid_plural ""
"All packages of the groups are already installed: dnf only records the "
"groups as installed."
msgstr[0] ""
"Tutti i pacchetti del gruppo sono già installati: dnf registra solo il "
"gruppo come installato."
msgstr[1] ""
"Tutti i pacchetti dei gruppi sono già installati: dnf registra solo i gruppi "
"come installati."

#: kram/app/apply_review.py:150
msgid ""
"No package goes with the group (you installed them yourself, or something "
"else needs them): dnf only records the group as removed."
msgid_plural ""
"No package goes with the groups (you installed them yourself, or something "
"else needs them): dnf only records the groups as removed."
msgstr[0] ""
"Nessun pacchetto viene rimosso con il gruppo (li hai installati tu, o "
"servono ad altro): dnf registra solo il gruppo come rimosso."
msgstr[1] ""
"Nessun pacchetto viene rimosso con i gruppi (li hai installati tu, o servono "
"ad altro): dnf registra solo i gruppi come rimossi."

#: kram/app/apply_review.py:154
msgid "No package changes: dnf only updates its record of the groups."
msgstr ""
"Nessun pacchetto cambia: dnf aggiorna solo la sua registrazione dei gruppi."

